cat > .gitignore << 'EOF'
# Python bytecode
__pycache__/
*.py[cod]
*.pyo
# Environment files
.env
.venv/
venv/
ENV/
# Build and Distribution
dist/
build/
*.egg-info/
.eggs/
# IDE / Editor settings
.vscode/
.idea/
*.swp
*.swo
# Operating system files
.DS_Store
Thumbs.db
# Logs and temporary files
*.log
*.tmp
*.bak
EOF
cat .gitignore
git add .gitignore
git commit -m "chore: update .gitignore with full Python and OS template"
git push

